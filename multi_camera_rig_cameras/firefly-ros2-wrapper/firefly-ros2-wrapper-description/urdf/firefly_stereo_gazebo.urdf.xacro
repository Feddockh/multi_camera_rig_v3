<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

    <!-- Gazebo (Ignition) sensor plugins for Firefly stereo camera -->
    <xacro:macro name="firefly_camera_gazebo" params="namespace:=firefly frame_rate:=5">

        <!-- Sensors plugin required for Ignition Gazebo camera simulation -->
        <!-- We added this in the .sdf file for the world, but it can also be added here -->

        <!-- Left Camera Sensor -->
        <gazebo reference="firefly_left_camera_frame">

            <sensor name="firefly_left_depth_camera" type="depth">
                <update_rate>${frame_rate}</update_rate>
                <visualize>false</visualize>
                <topic>/firefly_left/sim/depth/image_raw</topic>
                <ignition_frame_id>firefly_left_camera_optical_frame</ignition_frame_id>
                <!-- <camera_info_topic>/firefly_left/depth/camera_info_sim</camera_info_topic> -->
                <camera>
                    <horizontal_fov>0.781</horizontal_fov>
                    <image>
                        <width>1440</width>
                        <height>1080</height>
                        <format>R_FLOAT32</format>
                    </image>
                    <clip>
                        <near>0.01</near>
                        <far>5</far>
                    </clip>
                </camera>
            </sensor>

            <sensor name="firefly_left_camera" type="camera">
                <update_rate>${frame_rate}</update_rate>
                <visualize>false</visualize>
                <topic>/firefly_left/sim/image_raw</topic>
                <ignition_frame_id>firefly_left_camera_optical_frame</ignition_frame_id>
                <!-- <camera_info_topic>/firefly_left/camera_info_sim</camera_info_topic> -->
                <camera>
                    <horizontal_fov>0.781</horizontal_fov>
                    <image>
                        <width>1440</width>
                        <height>1080</height>
                        <format>R8G8B8</format>
                    </image>
                    <clip>
                        <near>0.01</near>
                        <far>5</far>
                    </clip>
                    <!-- <intrinsics>
                        <fx>858.0626964569092</fx>
                        <fy>858.0626320838928</fy>
                        <cx>720.0</cx>
                        <cy>540.0</cy>
                        <s>0.0</s>
                    </intrinsics> -->
                </camera>
            </sensor>

        </gazebo>

        <!-- Right Camera Sensor -->
        <gazebo reference="firefly_right_camera_frame">

            <sensor name="firefly_right_depth_camera" type="depth">
                <update_rate>${frame_rate}</update_rate>
                <visualize>false</visualize>
                <topic>/firefly_right/sim/depth/image_raw</topic>
                <ignition_frame_id>firefly_right_camera_optical_frame</ignition_frame_id>
                <!-- <camera_info_topic>/firefly_right/depth/camera_info_sim</camera_info_topic> -->
                <camera>
                    <horizontal_fov>0.781</horizontal_fov>
                    <image>
                        <width>1440</width>
                        <height>1080</height>
                        <format>R_FLOAT32</format>
                    </image>
                    <clip>
                        <near>0.01</near>
                        <far>5</far>
                    </clip>
                </camera>
            </sensor>

            <sensor name="firefly_right_camera" type="camera">
                <update_rate>${frame_rate}</update_rate>
                <visualize>false</visualize>
                <topic>/firefly_right/sim/image_raw</topic>
                <ignition_frame_id>firefly_right_camera_optical_frame</ignition_frame_id>
                <!-- <camera_info_topic>/firefly_right/camera_info_sim</camera_info_topic> -->
                <!-- Create 6cm baseline for Gazebo stereo calibration -->
                <!-- <pose>0 0 0 0 0 0</pose>   -->
                <camera>
                    <horizontal_fov>0.781</horizontal_fov>
                    <image>
                        <width>1440</width>
                        <height>1080</height>
                        <!-- <width>1280</width>
                        <height>960</height> -->
                        <format>R8G8B8</format>
                    </image>
                    <!-- <anti_aliasing>0</anti_aliasing> -->
                    <clip>
                        <near>0.01</near>
                        <far>5</far>
                    </clip>
                    <!-- Right camera calibration matrix with stereo baseline -->
                    <!-- <intrinsics>
                        <fx>858.0626106262207</fx>
                        <fy>858.0626964569092</fy>
                        <cx>720.0</cx>
                        <cy>540.0</cy>
                        <s>0.0</s>
                    </intrinsics> -->
                    <!-- Stereo projection matrix with 6cm baseline -->
                    <!-- -fx * baseline = -858.06 * 0.06 -->
                    <!-- <projection>
                        <p_fx>858.0626106262207</p_fx>
                        <p_fy>858.0626964569092</p_fy>
                        <p_cx>720.0</p_cx>
                        <p_cy>540.0</p_cy>
                        <tx>-51.48375</tx> 
                        <ty>0.0</ty>
                    </projection> -->
                    <!-- <noise>
                        <type>gaussian</type>
                        <mean>0.0</mean>
                        <stddev>0.007</stddev>
                    </noise> -->
                </camera>
            </sensor>
        </gazebo>

    </xacro:macro>
</robot>

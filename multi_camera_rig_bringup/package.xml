<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>multi_camera_rig_bringup</name>
  <version>0.0.1</version>
  <description>Launch files for bringing up complete multi-camera rig systems with cameras, detection, and reconstruction.</description>
  <maintainer email="hayden4feddock@gmail.com">Hayden Feddock</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>multi_camera_rig_common</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>libopencv-dev</depend>
  <depend>eigen</depend>

  <exec_depend>firefly-ros2-wrapper-bringup</exec_depend>
  <exec_depend>firefly-ros2-wrapper-description</exec_depend>
  <exec_depend>multi_camera_rig_detection</exec_depend>
  <exec_depend>multi_camera_rig_reconstruction</exec_depend>
  <exec_depend>multi_camera_rig_trigger</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
